# Raised from 0.78: in testing, disguised duplicates scored 0.83-0.90 while
# false positives peaked at 0.80.
similarity_floor: 0.82
confidence_threshold: 0.75
ignore_paths:
  - "**/node_modules/**"
  - "**/*.lock"
  - "**/dist/**"
enabled_checks:
  duplication: true
  architectural_violation: true
# Files skipped by the PR review, both as changed code and as matches.
# Omit to skip tests (tests/**, test_*.py, *.spec.*, ...); set [] to review everything.
# review_ignore_paths:
#   - "tests/**"
#   - "**/migrations/**"
# How many wiki rules each changed function is checked against (0 turns the
# rule lookup off). Rules come from docs/, wiki/, ARCHITECTURE.md, CONTRIBUTING.md
# and similar files in the indexed repository.
# wiki_top_k: 4
