GITHUB_TOKEN=
# Required in production: must match the secret set on the GitHub webhook.
# If empty, unsigned webhooks are accepted (local dev only).
GITHUB_WEBHOOK_SECRET=
# Set to true to actually post comments; otherwise they are only logged.
POST_TO_GITHUB=false
OLLAMA_HOST=http://localhost:11434
# Local on-disk Qdrant; set QDRANT_URL instead to use a Qdrant server (e.g. Docker).
QDRANT_PATH=./data/qdrant
# QDRANT_URL=http://localhost:6333
# Folder containing the .agent-review.yml the agent should use.
AGENT_REVIEW_CONFIG_ROOT=.
